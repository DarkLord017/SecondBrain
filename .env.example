OPENAI_API_KEY=
# Defaults to OpenRouter; point this at api.openai.com (or any OpenAI-compatible host) if you'd rather use that.
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter-style model slug, e.g. anthropic/claude-sonnet-4.5 or openai/gpt-5
LLM_MODEL=

SUPERMEMORY_API_KEY=

LLAMAPARSE_API_KEY=

DATABASE_URL=postgresql://secondbrain:secondbrain@localhost:5432/secondbrain
REDIS_URL=redis://localhost:6379/0

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

SPEND_CAP_USD=5.0
THROTTLE_PER_MIN=30
MAX_CONCURRENT_STREAMS=5

# Set these to match whatever LLM_MODEL actually costs on OpenRouter.
PRICE_PER_1K_INPUT_TOKENS=0.003
PRICE_PER_1K_OUTPUT_TOKENS=0.015
MAX_RESPONSE_TOKENS_ESTIMATE=1000

CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

UPLOAD_QUOTA_BYTES_PER_DAY=524288000
